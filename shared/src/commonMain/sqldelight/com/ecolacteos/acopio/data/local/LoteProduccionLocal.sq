import com.ecolacteos.acopio.core.Decimal;
import com.ecolacteos.acopio.domain.model.SyncStatus;
import kotlinx.datetime.LocalDate;
import kotlinx.datetime.LocalDateTime;

-- MOBILE_ARCHITECTURE.md §11.1.
CREATE TABLE lote_produccion_local (
  uuid_cliente        TEXT NOT NULL PRIMARY KEY,
  server_id           TEXT,
  usuario_id          TEXT NOT NULL,
  fecha               TEXT AS LocalDate NOT NULL,
  tipo_queso_id       TEXT NOT NULL,
  litros_usados       TEXT AS Decimal NOT NULL,
  unidades_obtenidas  INTEGER AS kotlin.Int NOT NULL,
  sync_status         TEXT AS SyncStatus NOT NULL,
  sync_attempts       INTEGER AS kotlin.Int NOT NULL DEFAULT 0,
  sync_error          TEXT,
  next_attempt_at     TEXT AS LocalDateTime,
  creado_en           TEXT AS LocalDateTime NOT NULL,
  sincronizado_en     TEXT AS LocalDateTime
);

insertar:
INSERT INTO lote_produccion_local (
  uuid_cliente, server_id, usuario_id, fecha, tipo_queso_id, litros_usados, unidades_obtenidas,
  sync_status, sync_attempts, sync_error, next_attempt_at, creado_en, sincronizado_en
) VALUES (
  :uuidCliente, :serverId, :usuarioId, :fecha, :tipoQuesoId, :litrosUsados, :unidadesObtenidas,
  :syncStatus, :syncAttempts, :syncError, :nextAttemptAt, :creadoEn, :sincronizadoEn
);

obtenerPorUuidCliente:
SELECT * FROM lote_produccion_local WHERE uuid_cliente = :uuidCliente;

-- Ajustado en Fase 5, mismo criterio que `analisis_calidad_local` (ver comentarios allí).
obtenerPendientes:
SELECT * FROM lote_produccion_local
WHERE usuario_id = :usuarioId
  AND (
    (sync_status = 'PENDING' AND (next_attempt_at IS NULL OR next_attempt_at <= :ahora))
    OR sync_status = 'SYNCING'
    OR (sync_status = 'FAILED' AND next_attempt_at IS NOT NULL AND next_attempt_at <= :ahora)
  )
ORDER BY creado_en ASC;

-- Un lote espera a que **todos** sus registros de acopio referenciados tengan id resoluble: no se puede
-- enviar `registroAcopioIds` a medias sin cambiar en silencio lo que el lote significa.
obtenerEnEsperaDeDependencia:
SELECT * FROM lote_produccion_local
WHERE usuario_id = :usuarioId AND sync_status = 'PENDING_DEPENDENCY'
ORDER BY creado_en ASC;

observarTodos:
SELECT * FROM lote_produccion_local WHERE usuario_id = :usuarioId ORDER BY fecha DESC;

-- Fase 6 §6: ver el comentario en RegistroAcopioLocal.sq.
contarPendientes:
SELECT COUNT(*) FROM lote_produccion_local WHERE usuario_id = :usuarioId AND sync_status <> 'SYNCED';

-- Fase 6 §6 (LogoutUseCase). uuid_cliente de los lotes de este usuario que ya están SYNCED -- el
-- LocalDataSource los usa para primero borrar sus filas hijas en lote_produccion_registro_local
-- (que no tiene usuario_id propio, así que no se puede filtrar directo) antes de borrar el lote.
obtenerUuidsSincronizadosDeUsuario:
SELECT uuid_cliente FROM lote_produccion_local WHERE usuario_id = :usuarioId AND sync_status = 'SYNCED';

eliminarSincronizadosDeUsuario:
DELETE FROM lote_produccion_local WHERE usuario_id = :usuarioId AND sync_status = 'SYNCED';

actualizarEstadoSync:
UPDATE lote_produccion_local
SET sync_status = :syncStatus, sync_attempts = :syncAttempts, sync_error = :syncError,
    next_attempt_at = :nextAttemptAt
WHERE uuid_cliente = :uuidCliente;

-- Renombrada en Fase 5 (era `actualizarServerId`) -- ver el comentario en `RegistroAcopioLocal.sq`.
marcarSincronizado:
UPDATE lote_produccion_local
SET server_id = COALESCE(:serverId, server_id), sincronizado_en = :sincronizadoEn, sync_status = 'SYNCED',
    sync_attempts = 0, sync_error = NULL, next_attempt_at = NULL
WHERE uuid_cliente = :uuidCliente;

eliminarSincronizadosAntesDe:
DELETE FROM lote_produccion_local WHERE sync_status = 'SYNCED' AND sincronizado_en < :fecha;
