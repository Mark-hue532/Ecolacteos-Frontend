import com.ecolacteos.acopio.core.Decimal;
import com.ecolacteos.acopio.domain.model.SyncStatus;
import kotlinx.datetime.LocalDateTime;

-- MOBILE_ARCHITECTURE.md §11.1. Captura propia offline-first, clave de idempotencia uuid_cliente.
CREATE TABLE registro_acopio_local (
  uuid_cliente          TEXT NOT NULL PRIMARY KEY,
  server_id             TEXT,
  usuario_id            TEXT NOT NULL,
  proveedor_id          TEXT NOT NULL,
  unidad_id             TEXT NOT NULL,
  fecha_hora            TEXT AS LocalDateTime NOT NULL,
  litros                TEXT AS Decimal NOT NULL,
  gps_lat               TEXT AS Decimal,
  gps_lng               TEXT AS Decimal,
  motivo_observacion_id TEXT,
  litros_por_voz        INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
  sync_status           TEXT AS SyncStatus NOT NULL,
  sync_attempts         INTEGER AS kotlin.Int NOT NULL DEFAULT 0,
  sync_error            TEXT,
  next_attempt_at       TEXT AS LocalDateTime,
  creado_en             TEXT AS LocalDateTime NOT NULL,
  sincronizado_en       TEXT AS LocalDateTime
);

insertar:
INSERT INTO registro_acopio_local (
  uuid_cliente, server_id, usuario_id, proveedor_id, unidad_id, fecha_hora, litros, gps_lat, gps_lng,
  motivo_observacion_id, litros_por_voz, sync_status, sync_attempts, sync_error, next_attempt_at,
  creado_en, sincronizado_en
) VALUES (
  :uuidCliente, :serverId, :usuarioId, :proveedorId, :unidadId, :fechaHora, :litros, :gpsLat, :gpsLng,
  :motivoObservacionId, :litrosPorVoz, :syncStatus, :syncAttempts, :syncError, :nextAttemptAt,
  :creadoEn, :sincronizadoEn
);

obtenerPorUuidCliente:
SELECT * FROM registro_acopio_local WHERE uuid_cliente = :uuidCliente;

-- Fase 8A (A-06): fallback local del propio dispositivo cuando `GET /api/registros-acopio/{id}` falla sin
-- conexión -- ver `RegistroAcopioRepository.obtenerDetalle`. `server_id` puede repetirse en teoría (nunca
-- en la práctica: lo asigna el motor de sync uno a uno), por eso LIMIT 1 en vez de una PK.
obtenerPorServerId:
SELECT * FROM registro_acopio_local WHERE server_id = :serverId LIMIT 1;

-- Candidatas a enviar en un ciclo de sync (ajustado en Fase 5, ver checkpoint):
--  · PENDING          -> nunca intentada (next_attempt_at NULL) o con backoff ya vencido.
--  · SYNCING          -> huérfana: la app murió a mitad de vuelo, o la respuesta omitió el ítem
--                        (§6.2). Reintentar es seguro por idempotencia de uuidCliente (§6.4/§7).
--  · FAILED transitorio -> tiene next_attempt_at; entra recién cuando ese instante pasó.
-- Un FAILED **permanente** (item en errores[], sin next_attempt_at) queda deliberadamente afuera:
-- §6.1 exige que no se reintente solo, requiere corrección del usuario.
obtenerPendientes:
SELECT * FROM registro_acopio_local
WHERE usuario_id = :usuarioId
  AND (
    (sync_status = 'PENDING' AND (next_attempt_at IS NULL OR next_attempt_at <= :ahora))
    OR sync_status = 'SYNCING'
    OR (sync_status = 'FAILED' AND next_attempt_at IS NOT NULL AND next_attempt_at <= :ahora)
  )
ORDER BY creado_en ASC;

observarTodos:
SELECT * FROM registro_acopio_local WHERE usuario_id = :usuarioId ORDER BY fecha_hora DESC;

-- Fase 6 (§16.4): historial de un proveedor puntual, para combinar con registro_acopio_cache
-- (RegistroAcopioRepository.observarHistorialProveedor). Sin filtrar por usuario_id a propósito: el
-- historial de un proveedor es el mismo para cualquier usuario del dispositivo que lo consulte.
observarPorProveedor:
SELECT * FROM registro_acopio_local WHERE proveedor_id = :proveedorId ORDER BY fecha_hora DESC;

-- Fase 6 §6: cuenta TODO lo no-SYNCED de un usuario, sin importar backoff/timing -- a diferencia de
-- obtenerPendientes (candidatas a enviar YA), esto incluye también el FAILED permanente (CLAUDE.md §3.6:
-- "sync_status distinto de SYNCED" es exactamente el criterio de qué bloquea logout).
contarPendientes:
SELECT COUNT(*) FROM registro_acopio_local WHERE usuario_id = :usuarioId AND sync_status <> 'SYNCED';

-- Fase 6 §6 (LogoutUseCase, conteo ya en 0): limpia el historial ya confirmado de ESTE usuario. A
-- diferencia de eliminarSincronizadosAntesDe (retención global, Fase 9, sin importar usuario_id), esto
-- se dispara al cerrar sesión y solo toca las filas del usuario que se está deslogueando.
eliminarSincronizadosDeUsuario:
DELETE FROM registro_acopio_local WHERE usuario_id = :usuarioId AND sync_status = 'SYNCED';

actualizarEstadoSync:
UPDATE registro_acopio_local
SET sync_status = :syncStatus, sync_attempts = :syncAttempts, sync_error = :syncError,
    next_attempt_at = :nextAttemptAt
WHERE uuid_cliente = :uuidCliente;

-- Renombrada en Fase 5 (era `actualizarServerId`): `server_id` es **nullable** a propósito -- el lote
-- `POST /api/sync/*` confirma por `uuidCliente` y NO devuelve el id de Postgres (`DATA-014`), así que una
-- fila puede quedar legítimamente SYNCED sin `server_id`. El nombre viejo prometía lo contrario.
marcarSincronizado:
UPDATE registro_acopio_local
SET server_id = COALESCE(:serverId, server_id), sincronizado_en = :sincronizadoEn, sync_status = 'SYNCED',
    sync_attempts = 0, sync_error = NULL, next_attempt_at = NULL
WHERE uuid_cliente = :uuidCliente;

eliminarSincronizadosAntesDe:
DELETE FROM registro_acopio_local WHERE sync_status = 'SYNCED' AND sincronizado_en < :fecha;
