import com.ecolacteos.acopio.core.Decimal;
import com.ecolacteos.acopio.domain.model.SyncStatus;
import kotlinx.datetime.LocalDateTime;

-- MOBILE_ARCHITECTURE.md §11.1. CHECK C-02: exactamente una de las dos referencias al padre es no-nula.
CREATE TABLE analisis_calidad_local (
  uuid_cliente                 TEXT NOT NULL PRIMARY KEY,
  server_id                    TEXT,
  usuario_id                   TEXT NOT NULL,
  registro_acopio_uuid_cliente TEXT,
  registro_acopio_server_id    TEXT,
  folio_muestra                TEXT NOT NULL,
  agua                         TEXT AS Decimal,
  proteina                     TEXT AS Decimal,
  lactosa                      TEXT AS Decimal,
  densidad                     TEXT AS Decimal,
  temperatura                  TEXT AS Decimal,
  ph                           TEXT AS Decimal,
  agua_anadida                 INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
  sync_status                  TEXT AS SyncStatus NOT NULL,
  sync_attempts                INTEGER AS kotlin.Int NOT NULL DEFAULT 0,
  sync_error                   TEXT,
  next_attempt_at              TEXT AS LocalDateTime,
  creado_en                    TEXT AS LocalDateTime NOT NULL,
  sincronizado_en              TEXT AS LocalDateTime,
  CHECK ((registro_acopio_uuid_cliente IS NULL) <> (registro_acopio_server_id IS NULL))
);

insertar:
INSERT INTO analisis_calidad_local (
  uuid_cliente, server_id, usuario_id, registro_acopio_uuid_cliente, registro_acopio_server_id,
  folio_muestra, agua, proteina, lactosa, densidad, temperatura, ph, agua_anadida, sync_status,
  sync_attempts, sync_error, next_attempt_at, creado_en, sincronizado_en
) VALUES (
  :uuidCliente, :serverId, :usuarioId, :registroAcopioUuidCliente, :registroAcopioServerId,
  :folioMuestra, :agua, :proteina, :lactosa, :densidad, :temperatura, :ph, :aguaAnadida, :syncStatus,
  :syncAttempts, :syncError, :nextAttemptAt, :creadoEn, :sincronizadoEn
);

obtenerPorUuidCliente:
SELECT * FROM analisis_calidad_local WHERE uuid_cliente = :uuidCliente;

-- Ajustado en Fase 5: mismos 3 casos que `registro_acopio_local.obtenerPendientes` (ver comentario allí).
-- PENDING_DEPENDENCY **ya no sale por acá**: no es una candidata a enviar, es una espera legítima (§6.1).
-- El Sync Engine la consulta aparte con `obtenerEnEsperaDeDependencia` para su paso de promoción, y así no
-- tiene que filtrar por estado en Kotlin una lista que mezcla dos cosas distintas.
obtenerPendientes:
SELECT * FROM analisis_calidad_local
WHERE usuario_id = :usuarioId
  AND (
    (sync_status = 'PENDING' AND (next_attempt_at IS NULL OR next_attempt_at <= :ahora))
    OR sync_status = 'SYNCING'
    OR (sync_status = 'FAILED' AND next_attempt_at IS NOT NULL AND next_attempt_at <= :ahora)
  )
ORDER BY creado_en ASC;

-- Filas retenidas a propósito porque su RegistroAcopio padre todavía no tiene `server_id` resoluble
-- (C-03, §18.1). No se envían; el Sync Engine las reevalúa al final de cada ciclo.
obtenerEnEsperaDeDependencia:
SELECT * FROM analisis_calidad_local
WHERE usuario_id = :usuarioId AND sync_status = 'PENDING_DEPENDENCY'
ORDER BY creado_en ASC;

observarTodos:
SELECT * FROM analisis_calidad_local WHERE usuario_id = :usuarioId ORDER BY creado_en DESC;

-- Fase 6 §6: ver el comentario en RegistroAcopioLocal.sq -- incluye PENDING_DEPENDENCY y FAILED
-- permanente, a diferencia de obtenerPendientes/obtenerEnEsperaDeDependencia por separado.
contarPendientes:
SELECT COUNT(*) FROM analisis_calidad_local WHERE usuario_id = :usuarioId AND sync_status <> 'SYNCED';

-- Fase 6 §6 (LogoutUseCase). Ver el comentario en RegistroAcopioLocal.sq.
eliminarSincronizadosDeUsuario:
DELETE FROM analisis_calidad_local WHERE usuario_id = :usuarioId AND sync_status = 'SYNCED';

actualizarEstadoSync:
UPDATE analisis_calidad_local
SET sync_status = :syncStatus, sync_attempts = :syncAttempts, sync_error = :syncError,
    next_attempt_at = :nextAttemptAt
WHERE uuid_cliente = :uuidCliente;

-- Renombrada en Fase 5 (era `actualizarServerId`) -- ver el comentario en `RegistroAcopioLocal.sq`.
marcarSincronizado:
UPDATE analisis_calidad_local
SET server_id = COALESCE(:serverId, server_id), sincronizado_en = :sincronizadoEn, sync_status = 'SYNCED',
    sync_attempts = 0, sync_error = NULL, next_attempt_at = NULL
WHERE uuid_cliente = :uuidCliente;

eliminarSincronizadosAntesDe:
DELETE FROM analisis_calidad_local WHERE sync_status = 'SYNCED' AND sincronizado_en < :fecha;
