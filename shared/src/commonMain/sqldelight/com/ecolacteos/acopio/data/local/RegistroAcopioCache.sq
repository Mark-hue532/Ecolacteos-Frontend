import com.ecolacteos.acopio.core.Decimal;
import com.ecolacteos.acopio.domain.model.Origen;
import kotlinx.datetime.LocalDateTime;

-- MOBILE_ARCHITECTURE.md §11.2, excepción #1 (C-02/C-04). Registros de acopio AJENOS, capturados por otro
-- dispositivo. Solo lectura, nunca se crea ni edita localmente. NUNCA se borra en masa en un ciclo de
-- catálogos (trampa #4 de PROMPT_FASE_04.md): borrarla dejaría sin forma de resolver server_id a
-- analisis_calidad_local/lote_produccion_registro_local con un padre ajeno todavía no sincronizado.
CREATE TABLE registro_acopio_cache (
  id                 TEXT NOT NULL PRIMARY KEY,
  uuid_cliente       TEXT,
  proveedor_id       TEXT,
  proveedor_nombre   TEXT,
  fecha_hora         TEXT AS LocalDateTime NOT NULL,
  litros             TEXT AS Decimal NOT NULL,
  tiene_observacion  INTEGER AS kotlin.Boolean,
  origen             TEXT AS Origen NOT NULL,
  actualizado_en     TEXT AS LocalDateTime NOT NULL
);

upsert:
INSERT OR REPLACE INTO registro_acopio_cache (
  id, uuid_cliente, proveedor_id, proveedor_nombre, fecha_hora, litros, tiene_observacion, origen,
  actualizado_en
) VALUES (
  :id, :uuidCliente, :proveedorId, :proveedorNombre, :fechaHora, :litros, :tieneObservacion, :origen,
  :actualizadoEn
);

obtenerPorServerId:
SELECT * FROM registro_acopio_cache WHERE id = :id;

-- Fase 6 (§16.4): para RegistroAcopioRepository.observarHistorialProveedor -- registros AJENOS de un
-- proveedor puntual, para combinar con registro_acopio_local (propios). Ver la nota de deduplicación de
-- DATA-013/DATA-014 en el checkpoint: puede mostrar un registro duplicado si el mismo dato está en las
-- dos tablas, limitación conocida y aceptada, no se soluciona acá.
obtenerPorProveedor:
SELECT * FROM registro_acopio_cache WHERE proveedor_id = :proveedorId ORDER BY fecha_hora DESC;

-- Fase 6 §6 (LogoutUseCase, C-09 RNF-12): esta SÍ es la excepción a "nunca borrado masivo" de la trampa
-- #4 de Fase 4 -- ese borrado masivo bloqueado es sobre un CICLO DE CATÁLOGOS (rompería la resolución de
-- padres ajenos en pleno sync), no sobre un logout. `MOBILE_ARCHITECTURE.md §4` es explícito: las 3 tablas
-- con datos personales de proveedores (incluida esta) se borran siempre al cerrar sesión.
deleteAll:
DELETE FROM registro_acopio_cache;

-- Retención C-04 (MOBILE_ARCHITECTURE.md §11.4, Fase 9 -- se escribe la query, nadie la llama todavía):
-- 30 días desde actualizado_en, SALVO las filas referenciadas por un hijo local que no esté SYNCED todavía
-- (lote_produccion_registro_local no tiene sync_status propio: hereda el de su lote_produccion_local padre).
eliminarAntesDeSalvoReferenciados:
DELETE FROM registro_acopio_cache
WHERE actualizado_en < :fecha
  AND id NOT IN (
    SELECT registro_acopio_server_id FROM analisis_calidad_local
    WHERE registro_acopio_server_id IS NOT NULL AND sync_status <> 'SYNCED'
  )
  AND id NOT IN (
    SELECT lprl.registro_acopio_server_id
    FROM lote_produccion_registro_local lprl
    INNER JOIN lote_produccion_local lpl ON lpl.uuid_cliente = lprl.lote_uuid_cliente
    WHERE lprl.registro_acopio_server_id IS NOT NULL AND lpl.sync_status <> 'SYNCED'
  );
